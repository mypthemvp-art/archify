{
  "mcpServers": {
    "agent-ops-gateway": {
      "command": "node",
      "args": [
        "../../../.cursor/plugins/local/agent-ops/mcp-servers/registry-gateway/proxy.mjs"
      ],
      "env": {
        "AGENT_OPS_GATEWAY_URL": "${AGENT_OPS_GATEWAY_URL}",
        "AGENT_OPS_PILOT_PLUGIN": "production-triage-copilot"
      }
    }
  },
  "_pilot": {
    "note": "Weeks 7–8: gateway-mediated reads only. No mutate connectors.",
    "allowed_connectors": [
      "cicd-observer",
      "observability-reader",
      "git-repository",
      "github-readonly",
      "docs-fetch-search",
      "policy-approval-gateway",
      "audit-evidence-store"
    ]
  }
}
