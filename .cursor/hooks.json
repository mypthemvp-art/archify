{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/policy-pre-tool.mjs"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/policy-pre-tool.mjs"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/policy-pre-tool.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/policy-pre-tool.mjs"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/post-tool-audit-log.mjs"
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/post-tool-audit-log.mjs"
      }
    ],
    "afterMCPExecution": [
      {
        "command": ".cursor/hooks/post-tool-audit-log.mjs"
      }
    ]
  }
}
