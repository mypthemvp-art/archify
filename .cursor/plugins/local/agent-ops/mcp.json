{
  "mcpServers": {
    "filesystem-workspace": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "git-readonly": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git", "--repository", "."]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "github-readonly": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_READONLY_TOKEN}"
      }
    },
    "postgres-readonly": {
      "command": "uvx",
      "args": ["mcp-server-postgres", "--read-only"],
      "env": {
        "DATABASE_URL": "${POSTGRES_READONLY_URL}"
      }
    },
    "policy-gateway": {
      "command": "node",
      "args": [".cursor/plugins/local/agent-ops/mcp-servers/policy-engine/stub-server.mjs"],
      "env": {
        "POLICY_MODE": "enforce",
        "AUDIT_ENDPOINT": "${AUDIT_ENDPOINT}"
      }
    }
  }
}
